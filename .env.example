# ── TraceMind environment variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Flask session security – generate with: python -c "import secrets; print(secrets.token_hex(32))"
TRACEMIND_SECRET_KEY=change-me-before-production

# Database URI – defaults to SQLite when unset (recommended for local dev)
# For MySQL: mysql+pymysql://user:password@host:3306/tracemind
# DATABASE_URL=sqlite:///instance/tracemind.db

# LLM provider key used by the analysis engine (Person 1)
# OPENAI_API_KEY=your-openai-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# OLLAMA_HOST=http://localhost:11434
